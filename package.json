{
  "name": "voyager-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-html.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "data": "node scripts/fetch-horizons.mjs",
    "validate": "esbuild scripts/validate-model.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validate-model.mjs --log-level=warning && node node_modules/.cache/validate-model.mjs",
    "deploy": "npm run build && gh-pages -d dist",
    "check": "node scripts/check-site.mjs",
    "test": "esbuild scripts/test-engine.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.cache/test-engine.mjs --log-level=warning && node node_modules/.cache/test-engine.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
